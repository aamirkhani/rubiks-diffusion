\citation{nichol2021}
\citation{nichol2021}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Greedy (search-free) solve rate versus training wall clock on the $3{\times }3{\times }3$, by scramble depth (512 cubes per probe). The denoising objective converts GPU-hours into search-free capability several times faster than value iteration, and is the only method that lifts off at depth 30 within either budget.}}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:training}{{6}{9}{Greedy (search-free) solve rate versus training wall clock on the $3{\times }3{\times }3$, by scramble depth (512 cubes per probe). The denoising objective converts GPU-hours into search-free capability several times faster than value iteration, and is the only method that lifts off at depth 30 within either budget}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Test-time compute scaling on the $3{\times }3{\times }3$ (200 hundred-move scrambles; identical batched no-dedup beam for both methods). \textbf  {Left:} solve rate vs.\ beam width. \textbf  {Right:} wall clock (log scale). The denoiser dominates at every width and is ${\sim }20\times $ faster at equal width because it scores candidates with the parent's forward pass rather than evaluating every child.}}{9}{figure.caption.15}\protected@file@percent }
\newlabel{fig:width}{{7}{9}{Test-time compute scaling on the $3{\times }3{\times }3$ (200 hundred-move scrambles; identical batched no-dedup beam for both methods). \textbf {Left:} solve rate vs.\ beam width. \textbf {Right:} wall clock (log scale). The denoiser dominates at every width and is ${\sim }20\times $ faster at equal width because it scores candidates with the parent's forward pass rather than evaluating every child}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Ablations: schedule and timestep conditioning}{9}{subsection.5.4}\protected@file@percent }
\newlabel{sec:ablations}{{5.4}{9}{Ablations: schedule and timestep conditioning}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces What ``noise schedule'' means in each world. \textbf  {Left:} in Gaussian diffusion the linear and cosine~\citep  {nichol2021} schedules shape the signal fraction $\bar  \alpha _t$---a knob with no analogue on a group, where a move either happened or did not. \textbf  {Right:} on the cube the schedule acts only through the induced training distribution over true distances, measured exactly here ($2{\times }10^6$ samples per schedule, oracle-labeled, $2{\times }2{\times }2$, $K{=}18$). Gray bars are the exact shell sizes of the group. All walk schedules under-cover deep shells; the shallow-biased schedule starves them, matching its last-place coverage in Table~\ref {tab:ablations}.}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:schedules}{{8}{10}{What ``noise schedule'' means in each world. \textbf {Left:} in Gaussian diffusion the linear and cosine~\citep {nichol2021} schedules shape the signal fraction $\bar \alpha _t$---a knob with no analogue on a group, where a move either happened or did not. \textbf {Right:} on the cube the schedule acts only through the induced training distribution over true distances, measured exactly here ($2{\times }10^6$ samples per schedule, oracle-labeled, $2{\times }2{\times }2$, $K{=}18$). Gray bars are the exact shell sizes of the group. All walk schedules under-cover deep shells; the shallow-biased schedule starves them, matching its last-place coverage in Table~\ref {tab:ablations}}{figure.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Noise-schedule and conditioning ablations on the $2{\times }2{\times }2$: greedy (search-free) solve rate over all $3{,}674{,}160$ states (with implied unsolved-state counts) and fraction of argmax moves that strictly reduce exact distance (100k uniform states; $t$-conditioned variant queried at $t{=}K$). 40k iterations each, single run per variant. Shallow/deep bias: $d = \lceil K u^2\rceil $ / $d = \lceil K \sqrt  {u}\rceil $, $u\sim \mathrm  {Unif}(0,1)$.}}{10}{table.caption.17}\protected@file@percent }
\newlabel{tab:ablations}{{3}{10}{Noise-schedule and conditioning ablations on the $2{\times }2{\times }2$: greedy (search-free) solve rate over all $3{,}674{,}160$ states (with implied unsolved-state counts) and fraction of argmax moves that strictly reduce exact distance (100k uniform states; $t$-conditioned variant queried at $t{=}K$). 40k iterations each, single run per variant. Shallow/deep bias: $d = \lceil K u^2\rceil $ / $d = \lceil K \sqrt {u}\rceil $, $u\sim \mathrm {Unif}(0,1)$}{table.caption.17}{}}
